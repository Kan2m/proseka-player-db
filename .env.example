# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 絶対に公開しないこと(NEXT_PUBLIC_ を付けない)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# X Developer Console > アプリ > OAuth 2.0 キー
X_CLIENT_ID=xxxxxxxx
# 絶対に公開しないこと
X_CLIENT_SECRET=xxxxxxxx

# ログイン Cookie の署名用。32文字以上のランダム文字列(環境ごとに別の値にする)
SESSION_SECRET=

# (任意) app/lib/auth.ts の ADMIN_X_IDS 以外に管理者を追加する場合(@なし・カンマ区切り)
ADMIN_X_IDS=

# (ローカル検証用) 1 にすると /auth/dev-login?handle=<Xのユーザー名> で X を通さずログインできる。
# next dev かつ localhost からのアクセスでのみ有効。本番(Vercel)には設定しないこと
DEV_LOGIN=
